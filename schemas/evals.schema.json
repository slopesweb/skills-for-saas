{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-for-saas.dev/schemas/evals.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill_name",
    "evals"
  ],
  "properties": {
    "skill_name": {
      "type": "string"
    },
    "evals": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "prompt",
          "expected_output",
          "assertions"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 10
          },
          "expected_output": {
            "type": "string",
            "minLength": 10
          },
          "assertions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
