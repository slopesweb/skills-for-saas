{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-for-saas.dev/schemas/bundle.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "skills"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
